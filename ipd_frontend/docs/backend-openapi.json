{
  "openapi": "3.1.0",
  "info": {
    "title": "SpeakEase AI Backend",
    "version": "0.1.0"
  },
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Health",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/speech/analyze": {
      "post": {
        "tags": [
          "speech"
        ],
        "summary": "Analyze",
        "operationId": "analyze_speech_analyze_post",
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/Body_analyze_speech_analyze_post"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AudioResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AlignedWord": {
        "properties": {
          "word": {
            "type": "string",
            "title": "Word"
          },
          "start": {
            "type": "number",
            "minimum": 0,
            "title": "Start"
          },
          "end": {
            "type": "number",
            "minimum": 0,
            "title": "End"
          }
        },
        "type": "object",
        "required": [
          "word",
          "start",
          "end"
        ],
        "title": "AlignedWord"
      },
      "AudioResponse": {
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "completed",
              "no_speech"
            ],
            "title": "Status"
          },
          "processing_status": {
            "type": "string",
            "const": "completed",
            "title": "Processing Status",
            "default": "completed"
          },
          "filename": {
            "type": "string",
            "title": "Filename"
          },
          "duration_seconds": {
            "type": "number",
            "title": "Duration Seconds"
          },
          "expected_text": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Expected Text"
          },
          "transcript": {
            "type": "string",
            "title": "Transcript"
          },
          "words": {
            "items": {
              "$ref": "#/components/schemas/AlignedWord"
            },
            "type": "array",
            "title": "Words"
          },
          "model": {
            "type": "string",
            "title": "Model"
          },
          "language": {
            "type": "string",
            "const": "en",
            "title": "Language",
            "default": "en"
          },
          "alignment_status": {
            "type": "string",
            "enum": [
              "completed",
              "partial",
              "failed",
              "skipped"
            ],
            "title": "Alignment Status"
          },
          "alignment_error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Alignment Error"
          },
          "unaligned_words": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Unaligned Words"
          }
        },
        "type": "object",
        "required": [
          "status",
          "filename",
          "duration_seconds",
          "expected_text",
          "transcript",
          "model",
          "alignment_status"
        ],
        "title": "AudioResponse"
      },
      "Body_analyze_speech_analyze_post": {
        "properties": {
          "file": {
            "type": "string",
            "format": "binary",
            "title": "File",
            "description": "WAV or WebM audio"
          },
          "expected_text": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 2000
              },
              {
                "type": "null"
              }
            ],
            "title": "Expected Text"
          }
        },
        "type": "object",
        "required": [
          "file"
        ],
        "title": "Body_analyze_speech_analyze_post"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HealthResponse": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status"
          },
          "service": {
            "type": "string",
            "title": "Service"
          }
        },
        "type": "object",
        "required": [
          "status",
          "service"
        ],
        "title": "HealthResponse"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
