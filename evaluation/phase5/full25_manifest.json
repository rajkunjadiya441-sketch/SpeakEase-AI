    {
      "recording_id": "8463-294828-0009",
      "duration_seconds": 4.17,
      "word_count": 14,
      "reference_text": "NOT ONCE DID HE COMMENT ON THE LENGTH OR THE HARDSHIPS OF A JOURNEY",
